diff --git a/app/os_x11_dnd.go b/app/os_x11_dnd.go
new file mode 100644
index 0000000..cea71b0
--- /dev/null
+++ b/app/os_x11_dnd.go
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: Unlicense OR MIT
+
+//go:build ((linux && !android) || freebsd || openbsd) && !nox11
+
+package app
+
+// WazzapClients patch: files dragged from another program onto the
+// window, by the XDND protocol (version 5), for SetDropHandler.
+//
+// The source sends client messages: XdndEnter with the types it offers,
+// XdndPosition as the pointer moves (each answered with XdndStatus, which
+// says whether a drop is welcome), then XdndLeave or XdndDrop. After a drop
+// the files' URIs are asked for as the XdndSelection selection, arrive in a
+// property of the window (SelectionNotify), and XdndFinished ends it.
+
+/*
+#include <stdlib.h>
+#include <X11/Xlib.h>
+#include <X11/Xatom.h>
+*/
+import "C"
+
+import "unsafe"
+
+type xdnd struct {
+	aware, enter, position, status, leave, drop, finished C.Atom
+	selection, typeList, actionCopy, uriList, data        C.Atom
+	// source is the window the drag comes from, and files whether it
+	// offers files.
+	source C.Window
+	files  bool
+}
+
+func (w *x11Window) xdndInit() {
+	d := &w.dnd
+	d.aware = w.atom("XdndAware", false)
+	d.enter = w.atom("XdndEnter", false)
+	d.position = w.atom("XdndPosition", false)
+	d.status = w.atom("XdndStatus", false)
+	d.leave = w.atom("XdndLeave", false)
+	d.drop = w.atom("XdndDrop", false)
+	d.finished = w.atom("XdndFinished", false)
+	d.selection = w.atom("XdndSelection", false)
+	d.typeList = w.atom("XdndTypeList", false)
+	d.actionCopy = w.atom("XdndActionCopy", false)
+	d.uriList = w.atom("text/uri-list", false)
+	d.data = w.atom("GIO_XDND_DATA", false)
+	// The property that says the window takes drops, and the version.
+	version := C.long(5)
+	C.XChangeProperty(w.x, w.xw, d.aware, C.XA_ATOM, 32, C.PropModeReplace,
+		(*C.uchar)(unsafe.Pointer(&version)), 1)
+}
+
+// xdndMessage handles a client message of a drag, and reports whether it
+// was one.
+func (w *x11Window) xdndMessage(ev *C.XClientMessageEvent) bool {
+	d := &w.dnd
+	l := (*[5]C.long)(unsafe.Pointer(&ev.data))
+	switch ev.message_type {
+	case d.enter:
+		d.source = C.Window(l[0])
+		d.files = false
+		if l[1]&1 == 0 {
+			// Up to three types come in the message itself.
+			for _, t := range l[2:] {
+				d.files = d.files || C.Atom(t) == d.uriList
+			}
+		} else {
+			d.files = w.xdndOffers(d.source)
+		}
+		d.files = d.files && dropHandler.Load() != nil
+		if d.files {
+			dragOver(true)
+		}
+	case d.position:
+		d.source = C.Window(l[0])
+		accept, action := C.long(0), C.long(0)
+		if d.files {
+			accept, action = 1, C.long(d.actionCopy)
+		}
+		w.xdndSend(d.status, accept, 0, 0, action)
+	case d.leave:
+		w.xdndEnd()
+	case d.drop:
+		d.source = C.Window(l[0])
+		if !d.files {
+			w.xdndSend(d.finished, 0, 0, 0, 0)
+			w.xdndEnd()
+			break
+		}
+		C.XConvertSelection(w.x, d.selection, d.uriList, d.data, w.xw, C.Time(l[2]))
+	default:
+		return false
+	}
+	return true
+}
+
+// xdndOffers reports whether the source's list of types, for a drag with
+// more than three, has files.
+func (w *x11Window) xdndOffers(source C.Window) bool {
+	var (
+		typ    C.Atom
+		format C.int
+		n, rem C.ulong
+		data   *C.uchar
+	)
+	st := C.XGetWindowProperty(w.x, source, w.dnd.typeList, 0, 1024, C.False, C.XA_ATOM,
+		&typ, &format, &n, &rem, &data)
+	if st != C.Success || data == nil {
+		return false
+	}
+	defer C.XFree(unsafe.Pointer(data))
+	if typ != C.XA_ATOM || format != 32 {
+		return false
+	}
+	// Xlib hands 32-bit items out as longs.
+	for _, a := range unsafe.Slice((*C.Atom)(unsafe.Pointer(data)), int(n)) {
+		if a == w.dnd.uriList {
+			return true
+		}
+	}
+	return false
+}
+
+// xdndReceive reads the dropped files' URIs, which the source wrote to
+// the window's property, and ends the drag.
+func (w *x11Window) xdndReceive(ev *C.XSelectionEvent) {
+	d := &w.dnd
+	ok := C.long(0)
+	if ev.property == d.data {
+		var (
+			typ    C.Atom
+			format C.int
+			n, rem C.ulong
+			data   *C.uchar
+		)
+		// The length is in 32-bit units: 4 MB of URIs at most.
+		st := C.XGetWindowProperty(w.x, w.xw, d.data, 0, 1<<20, C.True, C.AnyPropertyType,
+			&typ, &format, &n, &rem, &data)
+		if st == C.Success && data != nil {
+			if format == 8 {
+				paths := fileURIs(C.GoStringN((*C.char)(unsafe.Pointer(data)), C.int(n)))
+				if h := dropHandler.Load(); h != nil && h.Drop != nil && len(paths) > 0 {
+					ok = 1
+					h.Drop(paths)
+				}
+			}
+			C.XFree(unsafe.Pointer(data))
+		}
+	}
+	action := C.long(0)
+	if ok != 0 {
+		action = C.long(d.actionCopy)
+	}
+	w.xdndSend(d.finished, ok, action, 0, 0)
+	w.xdndEnd()
+}
+
+// xdndEnd forgets the drag.
+func (w *x11Window) xdndEnd() {
+	if w.dnd.files {
+		dragOver(false)
+	}
+	w.dnd.source, w.dnd.files = 0, false
+}
+
+// xdndSend sends the drag's source a message; its first item is always
+// this window.
+func (w *x11Window) xdndSend(msg C.Atom, l1, l2, l3, l4 C.long) {
+	if w.dnd.source == 0 {
+		return
+	}
+	var xev C.XEvent
+	ev := (*C.XClientMessageEvent)(unsafe.Pointer(&xev))
+	*ev = C.XClientMessageEvent{
+		_type:        C.ClientMessage,
+		display:      w.x,
+		window:       w.dnd.source,
+		message_type: msg,
+		format:       32,
+	}
+	l := (*[5]C.long)(unsafe.Pointer(&ev.data))
+	l[0], l[1], l[2], l[3], l[4] = C.long(w.xw), l1, l2, l3, l4
+	C.XSendEvent(w.x, w.dnd.source, C.False, C.NoEventMask, &xev)
+	C.XFlush(w.x)
+}
