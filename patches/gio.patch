+	// pointer's, as a browser's :focus-visible.
+	Keyboard bool
+}
+
+// Focus describes the keyboard focus.
+func (s Source) Focus() FocusInfo {
+	if !s.Enabled() {
+		return FocusInfo{}
+	}
+	q := s.r
+	fi := FocusInfo{Tag: q.state().keyState.focus, Trapped: q.key.queue.trap > 0, Keyboard: q.keyboard}
