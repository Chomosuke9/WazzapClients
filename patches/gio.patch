 )
 
+// WazzapClients patch: files dropped on a window, and the token that lets
+// one come to the front.
+
+// DropHandler hears about files dragged from another program over a
+// window. Its functions run on the window's thread and must not wait for
+// the program's event loop.
+type DropHandler struct {
+	// Over is called when a drag of files comes over the window and when
+	// it leaves or ends.
+	Over func(on bool)
+	// Drop is called with the paths of the files dropped.
+	Drop func(paths []string)
+}
+
+var dropHandler atomic.Pointer[DropHandler]
+
+// SetDropHandler makes h hear about files dragged over every window (on
+// Wayland and X11), or nothing when h is nil.
+func SetDropHandler(h *DropHandler) { dropHandler.Store(h) }
+
+type activation struct {
+	token string
+	at    time.Time
+}
+
+var activationToken atomic.Pointer[activation]
+
+// SetActivationToken gives the next Perform(system.ActionRaise) the
+// token of the user's action that asked for it (a click on a notification
+// or tray icon, another program's launch), which a Wayland compositor
+// wants before it lets a window come to the front (xdg-activation). Without
+// one the window asks for a token itself, which the compositor may only
+// take as a call for attention.
+func SetActivationToken(token string) {
+	activationToken.Store(&activation{token: token, at: time.Now()})
+}
+
+// takeActivationToken returns the token set a moment ago, once.
+func takeActivationToken() string {
+	a := activationToken.Swap(nil)
+	if a == nil || time.Since(a.at) > 30*time.Second {
+		return ""
+	}
+	return a.token
+}
+
 // errOutOfDate is reported when the GPU surface dimensions or properties no
 // longer match the window.
 var errOutOfDate = errors.New("app: GPU surface out of date")
