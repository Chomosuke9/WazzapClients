+// SPDX-License-Identifier: Unlicense OR BSD-3-Clause
+
+package opentype
+
+import "bytes"
+
+// BytesReader is a Resource over font data held in memory (embedded or
+// memory-mapped). Loaders on a BytesReader return tables as subslices of
+// the data instead of copying them, so the data must not change while
+// fonts loaded from it are in use.
+//
+// This is a WazzapClients patch: copying the tables put whole fonts (a
+// 10 MB color emoji font, say) on the heap even when they are already in
+// memory.
+type BytesReader struct {
+	*bytes.Reader
+	data []byte
+}
+
+// NewBytesReader returns a Resource reading data without copying it.
+func NewBytesReader(data []byte) *BytesReader {
+	return &BytesReader{Reader: bytes.NewReader(data), data: data}
+}
