diff --git a/fontscan/mmap.go b/fontscan/mmap.go
new file mode 100644
index 0000000..9b49dcf
--- /dev/null
+++ b/fontscan/mmap.go
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: Unlicense OR BSD-3-Clause
+
+package fontscan
+
+import "sync"
+
+// WazzapClients patch: system fonts are memory-mapped rather than read, so
+// their tables stay in the (shared, evictable) file cache instead of the
+// heap. Mappings are copy-on-write and kept for the life of the process,
+// one per file, since loaded faces point into them.
+var mapped struct {
+	sync.Mutex
+	files map[string][]byte
+}
+
+// mapFontFile returns the content of a font file, mapped into memory.
+func mapFontFile(path string) ([]byte, bool) {
+	mapped.Lock()
+	defer mapped.Unlock()
+	if data, ok := mapped.files[path]; ok {
+		return data, true
+	}
+	data, ok := mmapFile(path)
+	if !ok {
+		return nil, false
+	}
+	if mapped.files == nil {
+		mapped.files = make(map[string][]byte)
+	}
+	mapped.files[path] = data
+	return data, true
+}
