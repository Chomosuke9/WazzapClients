new file mode 100644
index 0000000..943a324
--- /dev/null
+++ b/fontscan/mmap_unix.go
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: Unlicense OR BSD-3-Clause
+
+//go:build unix
+
+package fontscan
+
+import (
+	"os"
+	"syscall"
+)
+
+func mmapFile(path string) ([]byte, bool) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, false
+	}
+	defer f.Close()
+	st, err := f.Stat()
+	if err != nil || st.Size() == 0 || st.Size() > 1<<30 {
+		return nil, false
+	}
+	data, err := syscall.Mmap(int(f.Fd()), 0, int(st.Size()), syscall.PROT_READ|syscall.PROT_WRITE, syscall.MAP_PRIVATE)
+	if err != nil {
+		return nil, false
+	}
+	return data, true
+}
diff --git a/fontscan/mmap_windows.go b/fontscan/mmap_windows.go
new file mode 100644
index 0000000..5251ed5
--- /dev/null
+++ b/fontscan/mmap_windows.go
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: Unlicense OR BSD-3-Clause
+
+package fontscan
+
+import (
+	"os"
+	"syscall"
+	"unsafe"
+)
+
+func mmapFile(path string) ([]byte, bool) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, false
+	}
+	defer f.Close()
+	st, err := f.Stat()
+	if err != nil || st.Size() == 0 || st.Size() > 1<<30 {
+		return nil, false
+	}
+	size := st.Size()
+	h, err := syscall.CreateFileMapping(syscall.Handle(f.Fd()), nil, syscall.PAGE_WRITECOPY,
+		uint32(size>>32), uint32(size), nil)
+	if err != nil {
+		return nil, false
+	}
+	defer syscall.CloseHandle(h)
+	addr, err := syscall.MapViewOfFile(h, syscall.FILE_MAP_COPY, 0, 0, uintptr(size))
+	if err != nil {
+		return nil, false
+	}
+	return unsafe.Slice((*byte)(unsafe.Pointer(addr)), int(size)), true
+}
