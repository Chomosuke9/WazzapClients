@@ -0,0 +1,80 @@
+package whatsmeow
+
+import (
+	"testing"
+
+	waBinary "github.com/polymorfa/hypermeow/binary"
+	"github.com/polymorfa/hypermeow/proto/waCommon"
+	"github.com/polymorfa/hypermeow/proto/waE2E"
+	"github.com/polymorfa/hypermeow/store"
+	"github.com/polymorfa/hypermeow/types"
+	"github.com/polymorfa/hypermeow/types/events"
+	waLog "github.com/polymorfa/hypermeow/util/log"
+	"google.golang.org/protobuf/proto"
+)
+
+// WazzapClients patch: a <status> stanza with <enc> nodes (how WhatsApp
+// delivers status updates since November 2026) goes to decryption, not
+// straight to an ack.
+func TestEncryptedStatusStanzaIsDecrypted(t *testing.T) {
+	me := types.NewJID("628000000001", types.DefaultUserServer)
+	me.Device = 5
+	cli := NewClient(&store.Device{ID: &me, LID: types.NewJID("100000000001", types.HiddenUserServer)}, waLog.Noop)
+	cli.DisabledFeatures.Signal = true // hands the stanza out undecrypted instead
+	var got *events.UndecryptedMessage
+	cli.AddEventHandler(func(evt any) {
+		if e, ok := evt.(*events.UndecryptedMessage); ok {
+			got = e
+		}
+	})
+	poster := types.NewJID("52416300998887", types.HiddenUserServer)
+	node := &waBinary.Node{Tag: "status", Attrs: waBinary.Attrs{
+		"from":        types.StatusBroadcastJID,
+		"id":          "A5B5650DBD9398A7C84ECCFA9FFB35A2",
+		"participant": poster,
+		"notify":      "Vivy",
+		"t":           "1794101501",
+		"type":        "text",
+	}, Content: []waBinary.Node{
+		{Tag: "enc", Attrs: waBinary.Attrs{"type": "pkmsg", "v": "2"}, Content: []byte{1}},
+		{Tag: "enc", Attrs: waBinary.Attrs{"type": "skmsg", "v": "2"}, Content: []byte{2}},
+	}}
+	cli.handleNode(t.Context(), node)
+	if got == nil {
+		t.Fatal("encrypted <status> stanza was dropped")
+	}
+	if got.Info.Chat != types.StatusBroadcastJID || got.Info.Sender != poster || got.Info.ID != "A5B5650DBD9398A7C84ECCFA9FFB35A2" {
+		t.Errorf("wrong info: chat %s, sender %s, id %s", got.Info.Chat, got.Info.Sender, got.Info.ID)
+	}
+}
+
+// WazzapClients patch: a status goes to LIDs alone, your own included;
+// the server refuses a list that mixes them with phone numbers.
+func TestStatusRecipientsAreLIDs(t *testing.T) {
+	me := types.NewJID("628000000001", types.DefaultUserServer)
+	me.Device = 5
+	ownLID := types.NewJID("100000000001", types.HiddenUserServer)
+	cli := NewClient(&store.Device{ID: &me, LID: ownLID}, waLog.Noop)
+	poster := types.NewJID("52416300998887", types.HiddenUserServer)
+	got := cli.statusLIDs(t.Context(), []types.JID{poster, me.ToNonAD(), poster})
+	if len(got) != 2 || got[0] != poster || got[1] != ownLID {
+		t.Errorf("recipients %v, want %v and %v", got, poster, ownLID)
+	}
+}
+
+// WazzapClients patch: a group status revoke is wrapped in
+// groupStatusMessageV2; its edit attribute comes from the inner protocol
+// message, 7 for your own and 8 as a group admin.
+func TestGroupStatusRevokeEditAttribute(t *testing.T) {
+	wrap := func(fromMe bool) *waE2E.Message {
+		return &waE2E.Message{GroupStatusMessageV2: &waE2E.FutureProofMessage{Message: &waE2E.Message{
+			ProtocolMessage: &waE2E.ProtocolMessage{Type: waE2E.ProtocolMessage_REVOKE.Enum(),
+				Key: &waCommon.MessageKey{FromMe: proto.Bool(fromMe), ID: proto.String("S1")}}}}}
+	}
+	if got := getEditAttribute(wrap(true)); got != types.EditAttributeSenderRevoke {
+		t.Errorf("own revoke = %q, want 7", got)
+	}
+	if got := getEditAttribute(wrap(false)); got != types.EditAttributeAdminRevoke {
+		t.Errorf("admin revoke = %q, want 8", got)
+	}
+}
