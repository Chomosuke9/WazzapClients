 func (cli *Client) handleUnencryptedMessage(ctx context.Context, node *waBinary.Node) {
+	// WazzapClients patch: since November 2026 WhatsApp delivers status
+	// updates as <status from="status@broadcast"> stanzas carrying the
+	// same <enc> nodes a <message> did. They were acked and dropped here.
+	// Decrypt them like a message; the node keeps its tag, so the ack
+	// stays class="status" with the stanza's type.
+	if _, encrypted := node.GetOptionalChildByTag("enc"); encrypted {
+		cli.handleEncryptedMessage(ctx, node)
+		return
+	}
 	info, err := cli.parseMessageInfo(node)
 	if err != nil {
 		cli.Log.Warnf("Failed to parse message: %v", err)
