@@ -0,0 +1,46 @@
+package whatsmeow
+
+import (
+	"testing"
+
+	waBinary "github.com/polymorfa/hypermeow/binary"
+	"github.com/polymorfa/hypermeow/store"
+	"github.com/polymorfa/hypermeow/types"
+	"github.com/polymorfa/hypermeow/types/events"
+	waLog "github.com/polymorfa/hypermeow/util/log"
+)
+
+// WazzapClients patch: a <status> stanza with <enc> nodes (how WhatsApp
+// delivers status updates since November 2026) goes to decryption, not
+// straight to an ack.
+func TestEncryptedStatusStanzaIsDecrypted(t *testing.T) {
+	me := types.NewJID("628000000001", types.DefaultUserServer)
+	me.Device = 5
+	cli := NewClient(&store.Device{ID: &me, LID: types.NewJID("100000000001", types.HiddenUserServer)}, waLog.Noop)
+	cli.DisabledFeatures.Signal = true // hands the stanza out undecrypted instead
+	var got *events.UndecryptedMessage
+	cli.AddEventHandler(func(evt any) {
+		if e, ok := evt.(*events.UndecryptedMessage); ok {
+			got = e
+		}
+	})
+	poster := types.NewJID("52416300998887", types.HiddenUserServer)
+	node := &waBinary.Node{Tag: "status", Attrs: waBinary.Attrs{
+		"from":        types.StatusBroadcastJID,
+		"id":          "A5B5650DBD9398A7C84ECCFA9FFB35A2",
+		"participant": poster,
+		"notify":      "Vivy",
+		"t":           "1794101501",
+		"type":        "text",
+	}, Content: []waBinary.Node{
+		{Tag: "enc", Attrs: waBinary.Attrs{"type": "pkmsg", "v": "2"}, Content: []byte{1}},
+		{Tag: "enc", Attrs: waBinary.Attrs{"type": "skmsg", "v": "2"}, Content: []byte{2}},
+	}}
+	cli.handleNode(t.Context(), node)
+	if got == nil {
+		t.Fatal("encrypted <status> stanza was dropped")
+	}
+	if got.Info.Chat != types.StatusBroadcastJID || got.Info.Sender != poster || got.Info.ID != "A5B5650DBD9398A7C84ECCFA9FFB35A2" {
+		t.Errorf("wrong info: chat %s, sender %s, id %s", got.Info.Chat, got.Info.Sender, got.Info.ID)
+	}
+}
