@@ -0,0 +1,33 @@
+// WazzapClients patch: Zaps (WhatsApp's Instants).
+
+package whatsmeow
+
+import (
+	"google.golang.org/protobuf/encoding/protowire"
+
+	"github.com/polymorfa/hypermeow/proto/waE2E"
+)
+
+// instantVideoField is Message.instantVideoMessage, which these
+// protobufs don't have yet: it travels in the unknown fields.
+const instantVideoField protowire.Number = 140
+
+// hasInstantVideo reports whether msg holds an instantVideoMessage.
+func hasInstantVideo(msg *waE2E.Message) bool {
+	b := msg.ProtoReflect().GetUnknown()
+	for len(b) > 0 {
+		num, typ, n := protowire.ConsumeTag(b)
+		if n < 0 {
+			return false
+		}
+		if num == instantVideoField && typ == protowire.BytesType {
+			return true
+		}
+		b = b[n:]
+		if n = protowire.ConsumeFieldValue(num, typ, b); n < 0 {
+			return false
+		}
+		b = b[n:]
+	}
+	return false
+}
