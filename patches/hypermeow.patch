diff --git a/status_patch.go b/status_patch.go
new file mode 100644
index 0000000..025ea64
--- /dev/null
+++ b/status_patch.go
@@ -0,0 +1,75 @@
+package whatsmeow
+
+import (
+	"context"
+
+	"github.com/polymorfa/hypermeow/types"
+)
+
+// WazzapClients patch: statusLIDs turns the people a message to
+// status@broadcast goes to, your own account among them, into LIDs. The
+// server answers a list that mixes phone numbers and LIDs with error 400,
+// and statuses are addressed by LID now: a like, to its poster's LID and
+// your own phone number, never went. The LIDs come from the store, the
+// missing ones from the server; someone who has none is left out. An
+// account without a LID of its own keeps the list as it is.
+func (cli *Client) statusLIDs(ctx context.Context, list []types.JID) []types.JID {
+	ownLID := cli.getOwnLID().ToNonAD()
+	if ownLID.IsEmpty() {
+		return list
+	}
+	ownPN := cli.getOwnID().ToNonAD()
+	var pns []types.JID
+	for _, jid := range list {
+		if jid.Server == types.DefaultUserServer && jid.User != ownPN.User {
+			pns = append(pns, jid.ToNonAD())
+		}
+	}
+	lids := map[types.JID]types.JID{}
+	if len(pns) > 0 {
+		known, err := cli.Store.LIDs.GetManyLIDsForPNs(ctx, pns)
+		if err != nil {
+			cli.Log.Warnf("Failed to get LIDs of status recipients: %v", err)
+		}
+		var missing []types.JID
+		for _, pn := range pns {
+			if lid := known[pn]; !lid.IsEmpty() {
+				lids[pn] = lid.ToNonAD()
+			} else {
+				missing = append(missing, pn)
+			}
+		}
+		if len(missing) > 0 {
+			info, err := cli.GetUserInfo(ctx, missing)
+			if err != nil {
+				cli.Log.Warnf("Failed to ask for LIDs of %d status recipients: %v", len(missing), err)
+			}
+			for _, pn := range missing {
+				if lid := info[pn].LID.ToNonAD(); !lid.IsEmpty() {
+					lids[pn] = lid
+				}
+			}
+		}
+	}
+	out := make([]types.JID, 0, len(list)+1)
+	seen := map[types.JID]bool{ownLID: true}
+	for _, jid := range list {
+		jid = jid.ToNonAD()
+		switch {
+		case jid.User == ownPN.User && jid.Server == types.DefaultUserServer:
+			continue // added below, as a LID
+		case jid.Server == types.DefaultUserServer:
+			lid, ok := lids[jid]
+			if !ok {
+				cli.Log.Warnf("Leaving %s out of a status send: no LID", jid)
+				continue
+			}
+			jid = lid
+		}
+		if !seen[jid] {
+			seen[jid] = true
+			out = append(out, jid)
+		}
+	}
+	return append(out, ownLID)
+}
