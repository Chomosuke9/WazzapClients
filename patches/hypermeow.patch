+// WazzapClients patch: Zaps (WhatsApp's Instants).
+
+package whatsmeow
+
+import (
+	"testing"
+
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+
+	"github.com/polymorfa/hypermeow/proto/waE2E"
+)
+
+// A Zap goes as type="media" with mediatype="instant_image" or
+// "instant_video", as WhatsApp's clients send and expect it.
+func TestInstantMediaType(t *testing.T) {
+	photo := &waE2E.Message{InstantImageMessage: &waE2E.ImageMessage{Mimetype: proto.String("image/jpeg")}}
+	vb, _ := proto.Marshal(&waE2E.VideoMessage{Seconds: proto.Uint32(3)})
+	video := &waE2E.Message{}
+	video.ProtoReflect().SetUnknown(protowire.AppendBytes(protowire.AppendTag(nil, instantVideoField, protowire.BytesType), vb))
+	for _, c := range []struct {
+		msg  *waE2E.Message
+		want string
+	}{{photo, "instant_image"}, {video, "instant_video"},
+		{&waE2E.Message{EphemeralMessage: &waE2E.FutureProofMessage{Message: photo}}, "instant_image"}} {
+		if typ, media := getTypeFromMessage(c.msg), getMediaTypeFromMessage(c.msg); typ != "media" || media != c.want {
+			t.Errorf("sent as type %q, mediatype %q, want media, %q", typ, media, c.want)
+		}
+	}
+	if hasInstantVideo(&waE2E.Message{Conversation: proto.String("hi")}) {
+		t.Error("a text holds a Zap")
+	}
+}
