+package whatsmeow
+
+import (
+	"testing"
+
+	"github.com/polymorfa/hypermeow/proto/waE2E"
+)
+
+// A chat's theme goes as type="media" with mediatype="chat_theme", as
+// WhatsApp's clients want it, and its photo under keys of its own.
+func TestChatThemeStanza(t *testing.T) {
+	msg := &waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{
+		Type:             waE2E.ProtocolMessage_CHAT_THEME_SETTING.Enum(),
+		ChatThemeSetting: &waE2E.ChatThemeSetting{},
+	}}
+	if typ, media := getTypeFromMessage(msg), getMediaTypeFromMessage(msg); typ != "media" || media != "chat_theme" {
+		t.Errorf("sent as type %q, mediatype %q", typ, media)
+	}
+	if got := mediaTypeToMMSType[MediaChatWallpaper]; got != "chat-wallpaper-image" {
+		t.Errorf("the photo is uploaded as %q", got)
+	}
+	// Other protocol messages stay text.
+	if media := getMediaTypeFromMessage(&waE2E.Message{ProtocolMessage: &waE2E.ProtocolMessage{Type: waE2E.ProtocolMessage_REVOKE.Enum()}}); media != "" {
+		t.Errorf("a revoke got mediatype %q", media)
+	}
+}
