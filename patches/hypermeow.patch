+package whatsmeow
+
+import (
+	"testing"
+
+	"github.com/polymorfa/hypermeow/proto/waE2E"
+)
+
+// WazzapClients patch: a sticker with a sound goes as a sticker does.
+func TestAudioStickerStanzaTypes(t *testing.T) {
+	msg := &waE2E.Message{AudioStickerMessage: &waE2E.FutureProofMessage{
+		Message: &waE2E.Message{StickerMessage: &waE2E.StickerMessage{}}}}
+	if got := getTypeFromMessage(msg); got != "media" {
+		t.Errorf("type %q, want media", got)
+	}
+	if got := getMediaTypeFromMessage(msg); got != "sticker" {
+		t.Errorf("mediatype %q, want sticker", got)
+	}
+}
